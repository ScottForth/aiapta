#!/bin/bash
# Double-click (Mac) to rebuild the carousel photo list after adding/removing photos.
cd "$(dirname "$0")"
if [ ! -f .starters-downloaded ]; then
  echo "Downloading starter photos..."
  curl -fsSL -o bhm-bulletin.jpg  "https://s3.amazonaws.com/unlayer.memberhub/1678817774119-BHM+Bulletin.jpg"
  curl -fsSL -o bhm-quilt.jpg     "https://s3.amazonaws.com/unlayer.memberhub/1678817787598-BMH+Quilt.jpg"
  curl -fsSL -o bhm-backdrop.jpg  "https://s3.amazonaws.com/unlayer.memberhub/1678817816486-BHM+backdrop.jpg"
  curl -fsSL -o bhm-drummers.jpg  "https://s3.amazonaws.com/unlayer.memberhub/1678817856279-BHM+drummers.jpg"
  curl -fsSL -o fall-fest.jpg     "https://s3.amazonaws.com/unlayer.memberhub/1675176245744-20221027_181507.jpg"
  curl -fsSL -o friendsgiving.jpg "https://s3.amazonaws.com/unlayer.memberhub/1675176013074-IMG_2905%281%29.JPG"
  touch .starters-downloaded
fi
{
  echo "// Auto-generated by update-photos. Re-run it after adding or removing photos."
  echo "window.SCHOOL_PHOTOS = ["
  find . -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' \) | sed 's|^\./||' | sort | while IFS= read -r f; do
    printf '  "%s",\n' "$(printf '%s' "$f" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  done
  echo "];"
} > photos.js
echo "Done: $(grep -c '^  "' photos.js) photos listed. You can close this window."
