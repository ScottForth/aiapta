@echo off
REM Double-click (Windows) to rebuild the carousel photo list after adding/removing photos.
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
 "$ErrorActionPreference='SilentlyContinue';" ^
 "if (-not (Test-Path '.starters-downloaded')) { Write-Host 'Downloading starter photos...';" ^
 "  $b='https://s3.amazonaws.com/unlayer.memberhub/';" ^
 "  @{'bhm-bulletin.jpg'='1678817774119-BHM+Bulletin.jpg';'bhm-quilt.jpg'='1678817787598-BMH+Quilt.jpg';'bhm-backdrop.jpg'='1678817816486-BHM+backdrop.jpg';'bhm-drummers.jpg'='1678817856279-BHM+drummers.jpg';'fall-fest.jpg'='1675176245744-20221027_181507.jpg';'friendsgiving.jpg'='1675176013074-IMG_2905%%281%%29.JPG'}.GetEnumerator() | ForEach-Object { Invoke-WebRequest -UseBasicParsing -Uri ($b+$_.Value) -OutFile $_.Key };" ^
 "  New-Item -ItemType File '.starters-downloaded' | Out-Null };" ^
 "$f = Get-ChildItem -File | Where-Object { $_.Extension -match '^\.(jpe?g|png|gif|webp)$' } | Sort-Object Name;" ^
 "$lines = @('// Auto-generated by update-photos. Re-run it after adding or removing photos.','window.SCHOOL_PHOTOS = [') + ($f | ForEach-Object { '  \"' + $_.Name + '\",' }) + @('];');" ^
 "[IO.File]::WriteAllLines((Join-Path (Get-Location) 'photos.js'), $lines);" ^
 "Write-Host ('Done: ' + $f.Count + ' photos listed.')"
pause
